# ============================================================
# Face Attendance System - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# ==========================================================
# Database Configuration
# ==========================================================
DB_HOST=mysql
DB_PORT=3306
DB_NAME=face_attendance
DB_USERNAME=faceadmin
DB_PASSWORD=your-secure-password-here

# ==========================================================
# Redis Configuration
# ==========================================================
REDIS_HOST=redis
REDIS_PORT=6379

# ==========================================================
# JWT Configuration
# ==========================================================
# Generate a secure random string (at least 32 characters)
# Example: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-key-at-least-32-characters-long
JWT_EXPIRATION=86400000

# ==========================================================
# Super Admin Configuration
# ==========================================================
# Initial super admin account created on first startup.
# Change SUPER_ADMIN_PASSWORD before the first `docker compose up`.
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_FULL_NAME=Super Administrator
SUPER_ADMIN_PASSWORD=CHANGE_ME_before_first_up

# ==========================================================
# Student Configuration
# ==========================================================
# Initial password for provisioned student accounts
# Students MUST change this on first login
STUDENT_INITIAL_PASSWORD=student@123

# ==========================================================
# Email Configuration (Gmail SMTP)
# ==========================================================
# MAIL_USERNAME is the SMTP account that sends the OTP / attendance mail.
# It must match the account the App Password was generated for.
# For Gmail: use an App Password, never your normal account password
# https://myaccount.google.com/apppasswords
MAIL_USERNAME=your-account@gmail.com
MAIL_PASSWORD=your-gmail-app-password-here
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587

# ==========================================================
# Face Recognition Configuration
# ==========================================================
# Recognition threshold (0.0 - 1.0, higher = stricter matching)
RECOGNITION_THRESHOLD=0.6
PYTHON_RECOGNITION_THRESHOLD=0.5

# Minimum face quality score (0.0 - 1.0)
MIN_FACE_QUALITY_SCORE=0.3

# InsightFace model (buffalo_s = small, buffalo_l = large)
INSIGHTFACE_MODEL_NAME=buffalo_s

# CPU = -1, GPU = 0 (requires CUDA setup)
INSIGHTFACE_CTX_ID=-1

# ==========================================================
# Attendance Session Configuration
# ==========================================================
# Geofence radius in meters
ATTENDANCE_RADIUS_METERS=50

# Session duration in minutes
ATTENDANCE_SESSION_MINUTES=10

# ==========================================================
# Performance Monitoring
# ==========================================================
# Enable detailed performance logging (true/false)
PERFORMANCE_MONITORING=true

# ==========================================================
# Service Ports (Optional - defaults provided)
# ==========================================================
# These are HOST-side ports. The container ports stay fixed at
# 3306 / 6379 / 8080 / 8000 and service-to-service traffic inside the
# Compose network always uses those, never these values.
FRONTEND_PORT=5173
BACKEND_PORT=8080
PYTHON_PORT=8000

# ==========================================================
# URLs (Optional - for development/debugging)
# ==========================================================
# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Backend origin (for Vite proxy)
BACKEND_ORIGIN=http://backend:8080

# API base URL (leave empty for same-origin)
VITE_API_BASE_URL=

# ==========================================================
# Debug Mode (Optional)
# ==========================================================
DEBUG=false
